{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom">
<title>{{ .Site.Title }}</title>
<id>{{ .Permalink }}</id>
<link href="{{ .Permalink }}"/>
{{ with .OutputFormats.Get "rss" }}<link href="{{ .Permalink }}" rel="self" type="application/atom+xml"/>{{ end }}
<updated>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</updated>
<author><name>Wtrwx</name></author>
{{ $pages := .RegularPages }}
{{ if .IsHome }}{{ $pages = .Site.RegularPages }}{{ end }}
{{ range where $pages "Type" "posts" }}
<entry>
<title>{{ .Title }}</title>
<id>{{ .Permalink }}</id>
<link href="{{ .Permalink }}"/>
<published>{{ .Date.Format "2006-01-02T15:04:05Z07:00" }}</published>
<updated>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</updated>
<summary>{{ .Description }}</summary>
<content type="html">{{ .Content | htmlEscape | safeHTML }}</content>
</entry>
{{ end }}
</feed>
